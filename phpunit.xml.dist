<?xml version="1.0" encoding="UTF-8"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	verbose="true"
	failOnRisky="true"
	failOnWarning="true"
	cacheResult="false"
>
	<testsuites>
		<testsuite name="Unit">
			<directory suffix="Test.php">tests/unit</directory>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory suffix=".php">includes/core</directory>
		</include>
	</coverage>
</phpunit>
